		"adapter",
		"date-fns",
		"now",
		"parser",
		"relative",
		"time",
		"timezone"
	],
	"homepage": "https://github.com/ver0-project/now-ish/tree/master/packages/now-ish_date-fns",
	"bugs": {
		"url": "https://github.com/ver0-project/now-ish/issues"
	},
	"license": "MIT",
	"author": "Anton Zinovyev <xog3@yandex.ru>",
	"repository": {
		"type": "git",
		"url": "https://github.com/ver0-project/now-ish"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
