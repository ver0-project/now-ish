		"lint:fix": "vp lint --fix"
	},
	"dependencies": {
		"@date-fns/tz": "^1.4.1",
		"date-fns": "^4.1.0"
	},
	"devDependencies": {
		"@ver0/now-ish": "workspace:*",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@ver0/now-ish": "^1.1.0"
	},
	"engines": {
		"node": ">=18"
