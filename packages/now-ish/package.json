{
	"name": "@ver0/now-ish",
	"version": "1.1.1",
	"description": "Parse relative time expressions like now-7d or now/w",
	"keywords": [
		"date",
		"expression",
		"grafana",
		"now",
		"parser",
		"relative",
		"time"
	],
	"homepage": "https://github.com/ver0-project/now-ish",
	"bugs": {
		"url": "https://github.com/ver0-project/now-ish/issues"
	},
	"license": "MIT",
	"author": "Anton Zinovyev <xog3@yandex.ru>",
	"repository": {
		"type": "git",
		"url": "https://github.com/ver0-project/now-ish"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"typecheck": "tsc --noEmit",
		"test": "vp test",
		"test:coverage": "vp test --coverage",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix"
	},
	"devDependencies": {
		"@date-fns/tz": "^1.4.1",
		"@ver0/now-ish_date-fns": "workspace:*",
		"date-fns": "^4.1.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=18"
	}
}
